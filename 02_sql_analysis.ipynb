      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab" data-lang="notebook-python"><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q1:&nbsp;Action&nbsp;movies&nbsp;released&nbsp;after&nbsp;2015&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q1&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;m.title,&nbsp;m.release_date</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;movies&nbsp;m</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;movie_genres&nbsp;mg&nbsp;ON&nbsp;m.movie_id&nbsp;=&nbsp;mg.movie_</span><span class="mtk21">id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;genres&nbsp;g&nbsp;ON&nbsp;mg.genre_id&nbsp;=&nbsp;g.genre_id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;WHERE&nbsp;g.genre_name&nbsp;=&nbsp;'Action'&nbsp;AND&nbsp;m.release_da</span><span class="mtk21">te&nbsp;&gt;&nbsp;'2015-01-01'</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;LIMIT&nbsp;5;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q1,&nbsp;conn))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"-"</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk12">50</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q2:&nbsp;Top&nbsp;10&nbsp;highest-grossing&nbsp;movies&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q2&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;m.title,&nbsp;m.revenue,&nbsp;group_concat(g.genr</span><span class="mtk21">e_name)&nbsp;as&nbsp;genres</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;movies&nbsp;m</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;movie_genres&nbsp;mg&nbsp;ON&nbsp;m.movie_id&nbsp;=&nbsp;mg.movie_</span><span class="mtk21">id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;genres&nbsp;g&nbsp;ON&nbsp;mg.genre_id&nbsp;=&nbsp;g.genre_id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;GROUP&nbsp;BY&nbsp;m.movie_id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;ORDER&nbsp;BY&nbsp;m.revenue&nbsp;DESC</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;LIMIT&nbsp;10;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q2,&nbsp;conn))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"-"</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk12">50</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q3:&nbsp;Average&nbsp;budget&nbsp;and&nbsp;revenue&nbsp;by&nbsp;genre&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q3&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;g.genre_name,&nbsp;AVG(m.budget)&nbsp;as&nbsp;avg_budg</span><span class="mtk21">et,&nbsp;AVG(m.revenue)&nbsp;as&nbsp;avg_revenue</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;genres&nbsp;g</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;movie_genres&nbsp;mg&nbsp;ON&nbsp;g.genre_id&nbsp;=&nbsp;mg.genre_</span><span class="mtk21">id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;movies&nbsp;m&nbsp;ON&nbsp;mg.movie_id&nbsp;=&nbsp;m.movie_id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;GROUP&nbsp;BY&nbsp;g.genre_name</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;ORDER&nbsp;BY&nbsp;avg_revenue&nbsp;DESC;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q3,&nbsp;conn))</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$352489089$-->Start coding or <span tabindex="0" role="button" class="link">generate</span> with AI.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>

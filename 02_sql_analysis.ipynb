      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab" data-lang="notebook-python"><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q4:&nbsp;Top&nbsp;10&nbsp;actors&nbsp;with&nbsp;most&nbsp;movie&nbsp;appearances</span><span class="mtk21">&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q4&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;actor_name,&nbsp;COUNT(movie_id)&nbsp;as&nbsp;movie_co</span><span class="mtk21">unt</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;cast</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;GROUP&nbsp;BY&nbsp;actor_name</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;ORDER&nbsp;BY&nbsp;movie_count&nbsp;DESC</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;LIMIT&nbsp;10;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q4,&nbsp;conn))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"-"</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk12">50</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q5:&nbsp;Directors&nbsp;with&nbsp;more&nbsp;than&nbsp;3&nbsp;movies&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q5&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;person_name,&nbsp;COUNT(movie_id)&nbsp;as&nbsp;movie_c</span><span class="mtk21">ount</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;crew</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;WHERE&nbsp;job&nbsp;=&nbsp;'Director'</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;GROUP&nbsp;BY&nbsp;person_name</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;Having&nbsp;movie_count&nbsp;&gt;&nbsp;3</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;ORDER&nbsp;BY&nbsp;movie_count&nbsp;DESC;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q5,&nbsp;conn))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"-"</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk12">50</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q6:&nbsp;Top&nbsp;10&nbsp;most&nbsp;frequently&nbsp;used&nbsp;keywords&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q6&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;keyword_name,&nbsp;COUNT(movie_id)&nbsp;as&nbsp;keywor</span><span class="mtk21">d_count</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;movie_keywords</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;GROUP&nbsp;BY&nbsp;keyword_name</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;ORDER&nbsp;BY&nbsp;keyword_count&nbsp;DESC</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;LIMIT&nbsp;10;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q6,&nbsp;conn))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"-"</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk12">50</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q7:&nbsp;High&nbsp;budget&nbsp;but&nbsp;low&nbsp;revenue&nbsp;movies&nbsp;(Subqu</span><span class="mtk21">ery)&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q7&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;title,&nbsp;budget,&nbsp;revenue</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;movies</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;WHERE&nbsp;budget&nbsp;&gt;&nbsp;(SELECT&nbsp;AVG(budget)&nbsp;FROM&nbsp;movies</span><span class="mtk21">&nbsp;WHERE&nbsp;budget&nbsp;&gt;&nbsp;0)</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;AND&nbsp;revenue&nbsp;&lt;&nbsp;(SELECT&nbsp;AVG(revenue)&nbsp;FROM&nbsp;movi</span><span class="mtk21">es&nbsp;WHERE&nbsp;revenue&nbsp;&gt;&nbsp;0)</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;LIMIT&nbsp;10;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q7,&nbsp;conn))</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$352489089$-->Start coding or <span tabindex="0" role="button" class="link">generate</span> with AI.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>

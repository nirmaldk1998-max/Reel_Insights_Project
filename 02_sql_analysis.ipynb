      <div class="editor flex lazy-editor" style=""><pre tabindex="0" class="lazy-virtualized" style="font-size: 14px; line-height: 19px;"><pre class="lazy-gutter"></pre><pre class="monaco-colorized colab colab" data-lang="notebook-python"><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q8:&nbsp;Actors&nbsp;in&nbsp;Christopher&nbsp;Nolan&nbsp;movies&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q8&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;DISTINCT&nbsp;c.actor_name</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;cast&nbsp;c</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;crew&nbsp;cr&nbsp;ON&nbsp;c.movie_id&nbsp;=&nbsp;cr.movie_id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;WHERE&nbsp;cr.person_name&nbsp;=&nbsp;'Christopher&nbsp;Nolan'&nbsp;AND</span><span class="mtk21">&nbsp;cr.job&nbsp;=&nbsp;'Director'</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;LIMIT&nbsp;10;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q8,&nbsp;conn))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"-"</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk12">50</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q9:&nbsp;Genre&nbsp;with&nbsp;highest&nbsp;average&nbsp;rating&nbsp;(min&nbsp;20</span><span class="mtk21">&nbsp;movies)&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q9&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;g.genre_name,&nbsp;AVG(m.vote_average)&nbsp;as&nbsp;av</span><span class="mtk21">g_rating,&nbsp;COUNT(m.movie_id)&nbsp;as&nbsp;movie_count</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;genres&nbsp;g</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;movie_genres&nbsp;mg&nbsp;ON&nbsp;g.genre_id&nbsp;=&nbsp;mg.genre_</span><span class="mtk21">id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;movies&nbsp;m&nbsp;ON&nbsp;mg.movie_id&nbsp;=&nbsp;m.movie_id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;GROUP&nbsp;BY&nbsp;g.genre_name</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;Having&nbsp;movie_count&nbsp;&gt;=&nbsp;20</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;ORDER&nbsp;BY&nbsp;avg_rating&nbsp;DESC</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;LIMIT&nbsp;1;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q9,&nbsp;conn))</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"-"</span><span class="mtk1">&nbsp;*&nbsp;</span><span class="mtk12">50</span><span class="mtk1">)</span></span><br><span><span></span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"===&nbsp;Q10:&nbsp;Top&nbsp;10&nbsp;movies&nbsp;with&nbsp;most&nbsp;keywords&nbsp;==="</span><span class="mtk1">)</span></span><br><span><span class="mtk1">q10&nbsp;=&nbsp;</span><span class="mtk21">"""</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;SELECT&nbsp;m.title,&nbsp;COUNT(mk.keyword_id)&nbsp;as&nbsp;keywor</span><span class="mtk21">d_count</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;FROM&nbsp;movies&nbsp;m</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;JOIN&nbsp;movie_keywords&nbsp;mk&nbsp;ON&nbsp;m.movie_id&nbsp;=&nbsp;mk.movi</span><span class="mtk21">e_id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;GROUP&nbsp;BY&nbsp;m.movie_id</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;ORDER&nbsp;BY&nbsp;keyword_count&nbsp;DESC</span></span><br><span><span class="mtk21">&nbsp;&nbsp;&nbsp;&nbsp;LIMIT&nbsp;10;</span></span><br><span><span class="mtk21">"""</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(pd.read_sql(q10,&nbsp;conn))</span></span><br><span><span></span></span><br><span><span class="mtk8">#&nbsp;Close&nbsp;database&nbsp;connection</span></span><br><span><span class="mtk1">conn.close()</span></span><br><span><span class="mtk15">print</span><span class="mtk1">(</span><span class="mtk21">"\n---&nbsp;Phase&nbsp;2&nbsp;SQL&nbsp;Analysis&nbsp;Completed&nbsp;Successfully</span><span class="mtk21">!&nbsp;---"</span><span class="mtk1">)</span></span><br></pre><colab-read-only-cell-placeholder style="display: none;"><template shadowrootmode="open"><!----><div><!--?lit$352489089$-->Start coding or <span tabindex="0" role="button" class="link">generate</span> with AI.</div></template></colab-read-only-cell-placeholder></pre></div><colab-form class="formview vertical layout flex"><div class="widget-area"></div></colab-form></div>
